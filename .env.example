# ---------- Кто пишет сценарии ----------
# auto — ключ API, если задан, иначе Claude Code по подписке, иначе черновик без ИИ;
# api | claude-code | off — выбрать явно
AI_ENGINE=auto

# Вариант 1. Подписка Claude (Pro/Max) через официальный Claude Code CLI — он уже есть в образе.
# Токен: docker compose exec reels claude setup-token (или `claude setup-token` на любом компьютере)
CLAUDE_CODE_OAUTH_TOKEN=
# Модель для CLI: пусто — по умолчанию в подписке; можно opus / sonnet / полный id
CLAUDE_CODE_MODEL=
CLAUDE_CODE_TIMEOUT=600

# Вариант 2. Ключ Anthropic API (оплата по токенам, console.anthropic.com)
ANTHROPIC_API_KEY=
# Модель и «глубина размышления» Claude (low / medium / high)
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# ---------- Озвучка ----------
# Провайдер по умолчанию: corp | edge | yandex | elevenlabs
TTS_DEFAULT_PROVIDER=corp

# Свой TTS (OpenAI-совместимый, Fun-CosyVoice3). Внутри docker-сети студии: http://tts:8000/v1
# Вместо этих имён подойдут и студийные TTS_BASE_URL / TTS_API_KEY.
CORP_TTS_BASE_URL=https://tts.cloudsmasters.ru/v1
CORP_TTS_API_KEY=
# Голоса id:Подпись через запятую. Пусто — список берётся с сервера (/v1/voices)
CORP_TTS_VOICES=
# Пауза между предложениями, с (фраза озвучивается по предложениям). 0 — одним запросом
CORP_TTS_SENTENCE_GAP=0.35

# Edge TTS (живой Microsoft, без ключа; текст уходит на серверы Microsoft). false — выключить
EDGE_TTS_ENABLED=true
EDGE_TTS_VOICES=ru-RU-SvetlanaNeural:Светлана — женский,ru-RU-DmitryNeural:Дмитрий — мужской
# Если edge-tts недоступен — озвучить клоном на своём TTS (svetlana/dmitry). off — выключить
EDGE_FALLBACK=corp

# Yandex SpeechKit: API-ключ из AI Studio (или сервисного аккаунта с ролью ai.speechkit-tts.user)
# и идентификатор каталога (folder id, вида b1g…)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICES=21m00Tcm4TlvDq8ikWAM:Rachel

# ---------- Запуск ----------
# Порт на хосте и домен для Traefik (docker-compose.traefik.yml)
REELS_PORT=8128
REELS_DOMAIN=reels.cloudsmasters.ru

# Пароль на сайт (HTTP Basic). Обязательно задайте, если сайт доступен из интернета
APP_USER=admin
# Пусто — пароль по умолчанию (в коде только его хеш); off — без пароля.
# Значение с «$» берите в одинарные кавычки, иначе docker compose подставит переменную: 'my$ecret'
APP_PASSWORD=
# Вместо пароля можно задать его хеш: python -m app.passwords 'пароль'
APP_PASSWORD_HASH=

# Публичный адрес сайта — для ссылок на видео в вебхуке n8n
PUBLIC_BASE_URL=https://reels.example.com
# Вебхук n8n: сюда придёт событие reel.ready, когда рилс собран
N8N_WEBHOOK_URL=

MAX_UPLOAD_MB=500
